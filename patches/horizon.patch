+
+/// Column grids for [`ProtoChunk::from_approximate`].
+pub struct ApproximateColumns<'a> {
+    pub min_y: i32,
+    pub height: i32,
+    pub sea_level: i32,
+    pub default_block: BlockStateId,
+    pub default_fluid: BlockStateId,
+    /// `surface[z * 16 + x]` is the y of the top solid block.
+    pub surface: &'a [i32; 256],
+    /// One byte per block. Index `((y - min_y) as usize) * 256 + z * 16 + x`.
+    /// Non-zero is a cave. Length is `height * 256`.
+    pub caves: &'a [u8],
+}
+
+#[derive(Clone, Copy)]
+enum Cover {
+    Grass,
+    Sand,
+    Gravel,
+}
+
+fn cover_of(name: &str) -> Cover {
+    if name.contains("desert") || name.contains("beach") || name.contains("badlands") {
+        Cover::Sand
+    } else if name.contains("stony") || name.contains("gravel") || name.contains("frozen_peaks") {
+        Cover::Gravel
+    } else if name.contains("ocean") || name.contains("river") {
+        Cover::Sand
+    } else {
+        Cover::Grass
+    }
+}
+
+fn registry_block(data: &GeneratorData, name: &str) -> Result<BlockStateId, GeneratorError> {
+    data.registry()
+        .default_state(name)
+        .ok_or_else(|| resource(format!("missing block {name}")))
+}
+
+fn fill_approximate(
+    data: &Arc<GeneratorData>,
+    pos: ChunkPos,
+    biomes: BiomeChunk<BiomeId>,
+    columns: ApproximateColumns<'_>,
+) -> Result<ProtoChunk, GeneratorError> {
+    if columns.height <= 0 || columns.height % 16 != 0 {
+        return Err(resource(
+            "approximate fill needs a positive multiple of 16 for the build height",
+        ));
+    }
+    let cells = columns.height as usize * 256;
+    if columns.caves.len() != cells {
+        return Err(resource(format!(
+            "cave mask has {} entries, expected {cells}",
+            columns.caves.len()
+        )));
+    }
+    let max_y = columns.min_y + columns.height - 1;
+    let default_name = data
+        .registry()
+        .state(columns.default_block)
+        .map(|state| state.name.as_str())
+        .unwrap_or("");
+    let layered = default_name == "minecraft:stone";
+    let nether = default_name == "minecraft:netherrack";
+    let bedrock = registry_block(data, "minecraft:bedrock")?;
+    let (grass, dirt, sand, gravel, deepslate) = if layered {
+        (
+            registry_block(data, "minecraft:grass_block")?,
+            registry_block(data, "minecraft:dirt")?,
+            registry_block(data, "minecraft:sand")?,
+            registry_block(data, "minecraft:gravel")?,
+            registry_block(data, "minecraft:deepslate")?,
+        )
+    } else {
+        (
+            BlockStateId(0),
+            BlockStateId(0),
+            BlockStateId(0),
+            BlockStateId(0),
+            BlockStateId(0),
+        )
+    };
+    let fluid = if data.block_states().get(columns.default_fluid).air {
+        None
+    } else {
+        Some(columns.default_fluid)
+    };
+    let mut chunk = TerrainChunk::new(
+        pos,
+        columns.min_y,
+        columns.height,
+        data.registry(),
+        data.block_states().clone(),
+    )
+    .map_err(stage("approximate"))?;
+    let origin_x = pos.x.wrapping_shl(4);
+    let origin_z = pos.z.wrapping_shl(4);
+    for lz in 0..16 {
+        for lx in 0..16 {
+            let wx = origin_x.wrapping_add(lx);
+            let wz = origin_z.wrapping_add(lz);
+            let column = (lz * 16 + lx) as usize;
+            let surface = columns.surface[column].clamp(columns.min_y, max_y);
+            let biome = *biomes.noise_biome([wx >> 2, columns.sea_level >> 2, wz >> 2]);
+            let cover = cover_of(data.biome_name(biome));
+            let cave_at = |y: i32| -> bool {
+                let yi = (y - columns.min_y) as usize;
+                columns.caves[yi * 256 + column] != 0
+            };
+            let solid = |y: i32| -> BlockStateId {
+                if !layered {
+                    return columns.default_block;
+                }
+                if y > surface - 4 {
+                    return match cover {
+                        Cover::Grass if y == surface && surface >= columns.sea_level => grass,
+                        Cover::Grass => dirt,
+                        Cover::Sand => sand,
+                        Cover::Gravel => gravel,
+                    };
+                }
+                if y < 0 {
+                    deepslate
+                } else {
+                    columns.default_block
+                }
+            };
+            let at = |y: i32| -> Option<BlockStateId> {
+                if y == columns.min_y || (nether && y == max_y) {
+                    return Some(bedrock);
+                }
+                if y > surface {
+                    return if y < columns.sea_level { fluid } else { None };
+                }
+                if cave_at(y) {
+                    return if y < columns.sea_level { fluid } else { None };
+                }
+                Some(solid(y))
+            };
+            let mut y = if nether {
+                max_y
+            } else {
+                surface.max(columns.sea_level - 1).min(max_y)
+            };
+            while y >= columns.min_y {
+                let Some(state) = at(y) else {
+                    y -= 1;
+                    continue;
+                };
+                let mut bot = y;
+                while bot > columns.min_y && at(bot - 1) == Some(state) {
+                    bot -= 1;
+                }
+                chunk
+                    .fill_solid_run(wx, y, wz, y - bot + 1, state)
+                    .map_err(stage("approximate"))?;
+                y = bot - 1;
+            }
+        }
+    }
+    chunk
+        .prime_heightmaps(PreLightChunkStage::Terrain.heightmaps())
+        .map_err(stage("approximate"))?;
+    chunk.set_generation_stage(PreLightChunkStage::Terrain);
+    Ok(ProtoChunk {
+        terrain: chunk,
+        biomes,
+        data: Arc::clone(data),
+        decorated: false,
+        block_entities: Vec::new(),
+        structure_starts: Vec::new(),
+        own_starts: Starts::default(),
+        entities: Vec::new(),
+    })
