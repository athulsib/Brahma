+    /// `columns.surface[z * 16 + x]` is the y of the top solid block.
+    /// `columns.caves[((y - min_y) as usize) * 256 + z * 16 + x] != 0` is a cave.
+    /// The mask length is `height * 256`.
+    pub fn from_approximate(
+        data: &Arc<GeneratorData>,
+        pos: ChunkPos,
+        biomes: BiomeChunk<BiomeId>,
+        columns: ApproximateColumns<'_>,
