+/// Facts, vanilla `--reports` (for `biome_parameters`) and `prepare_worldgen`.
+fn generator_steps(run: &Run, lock: &artifacts::Lock) -> Result<(), String> {
+    let root = &run.resources;
+    let server_cp = run.server_classpath.as_str();
+    let oracle = run.oracle("VanillaHeightmapOracle.java");
+    let facts = root.join("facts.json");
+    let origin_same = run
+        .origin
+        .as_object()
+        .unwrap()
+        .iter()
+        .all(|(k, v)| run.previous(k) == Some(v));
+    if !(origin_same
+        && facts.exists()
+        && run.previous("facts_sha256") == Some(&run.file_hash("facts.json")?))
+    {
+        run.export(
+            "block states",
+            server_cp,
+            &root.join("classes"),
+            &[&oracle],
+            &["VanillaHeightmapOracle"],
+            "512M",
+            &["export".into(), arg(&facts)],
+            &root.join("export.log"),
+        )?;
+    }
+
+    let biomes = root.join("biome-parameters").join("overworld.json");
+    if !biomes.is_file() || !run.same("server_sha256") {
+        (run.log)("Running vanilla's data generator reports");
+        let datagen = run.local.join("datagen");
+        mkdir(&datagen)?;
+        let log_path = datagen.join("datagen.log");
+        let log = run.log_file(&log_path)?;
+        run.jdk
+            .java(
+                &[
+                    "-DbundlerMainClass=net.minecraft.data.Main".into(),
+                    "-jar".into(),
+                    arg(&lock.directory.join("jars").join("server.jar")),
+                    "--reports".into(),
+                    "--output".into(),
+                    "out".into(),
+                ],
+                Some(&datagen),
+                &log,
+            )
+            .map_err(|e| format!("{e} in the data generator; see {}", log_path.display()))?;
+        install_datagen_reports(root, &datagen.join("out").join("reports"))?;
+    }
+    if !biomes.is_file() {
+        return Err(format!("data generator did not write {}", biomes.display()));
+    }
+
+    prepare_worldgen(run)?;
+
+    let mut manifest = vec![("schema".to_string(), Value::Int(SCHEMA.to_string()))];
+    manifest.extend(run.origin.as_object().unwrap().iter().cloned());
+    manifest.push(("facts_sha256".into(), run.file_hash("facts.json")?));
+    manifest.push(("generator".into(), Value::Int("1".into())));
+    write_json(
+        &root.join("horizon-resources.json"),
+        &Value::Object(manifest),
+    )
+}
